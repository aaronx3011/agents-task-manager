# VPS2 (database host) — copy to deploy/production-db/.env on the host, chmod 600.
# Never commit the real file.
POSTGRES_PASSWORD=generate-a-url-safe-password
# This host's private address; PostgreSQL binds only here (scripts/deploy_db.sh
# refuses public addresses). Firewall 5432 to VPS1's private address only.
DB_BIND_ADDRESS=10.0.0.2
DB_PORT=5432
# Nightly backups: hour (UTC), retention in days, and the host directory.
BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
