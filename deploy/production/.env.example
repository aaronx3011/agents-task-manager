# VPS1 (app host) — copy to deploy/production/.env on the host, chmod 600, fill in.
# Never commit the real file.
DJANGO_SECRET_KEY=generate-with-openssl-rand-hex-48
POSTGRES_PASSWORD=same-url-safe-password-as-the-database-host
# VPS2's private address (WireGuard/VPC), reachable only from this host.
DB_HOST=10.0.0.2
DB_PORT=5432
# Public hostname served by Caddy, and the ACME contact email for Let's Encrypt.
SITE_ADDRESS=coordinator.example.com
TLS=ops@example.com
# Optional: move or disable Django admin (superuser-only operations).
# DJANGO_ADMIN_PATH=admin
# DJANGO_ADMIN_ENABLED=true
