DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate a unique value for each deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Leave empty for SQLite. Use Postgres when multiple agents claim concurrently.
DATABASE_URL=
# DATABASE_URL=postgresql://coordinator:change-me@localhost:5432/coordinator
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_TRUST_PROXY=false
COORDINATOR_URL=http://localhost:8000
COORDINATOR_API_KEY=
# Required only by Docker Compose. Use a URL-safe password in DATABASE_URL.
POSTGRES_PASSWORD=
# Required for cross-process WebSocket delivery. Empty uses single-process memory layer.
REDIS_URL=
