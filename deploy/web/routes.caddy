# Shared routing for every front door (#50, #52): the SPA as static files on the
# same origin, the API, WebSockets, admin and health proxied to Django.
(app) {
	encode zstd gzip

	# ADMIN_PATH must match DJANGO_ADMIN_PATH (#53).
	@backend path /api /api/* /ws/* /{$ADMIN_PATH:admin} /{$ADMIN_PATH:admin}/* /static/* /healthz
	handle @backend {
		reverse_proxy {$API_UPSTREAM:web:8000}
	}

	# Hashed build assets never change.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path is a client-side route: serve the app shell, never cached.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
}
