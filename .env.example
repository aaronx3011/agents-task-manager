DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate a unique value for each deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Leave empty for SQLite. Use Postgres when multiple agents claim concurrently.
DATABASE_URL=
# DATABASE_URL=postgresql://coordinator:change-me@localhost:5432/coordinator
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_TRUST_PROXY=false
COORDINATOR_URL=http://localhost:8000
COORDINATOR_API_KEY=
# Required only by Docker Compose. Use a URL-safe password in DATABASE_URL.
POSTGRES_PASSWORD=
# Required for cross-process WebSocket delivery and shared live session cache.
# Empty uses single-process memory channels/cache.
REDIS_URL=
# ASGI process count in Docker Compose (Redis is required when greater than one).
WEB_CONCURRENCY=2
# Worker liveness is separate from task ownership/reaper settings.
WORKER_OFFLINE_SECONDS=10
TASK_CLAIM_TIMEOUT_MINUTES=15
TASK_REAPER_INTERVAL_SECONDS=300
WORKER_SESSION_KEEP=500
WORKER_MESSAGE_KEEP=120
WORKER_EVENT_KEEP=5000
WORKER_EVENT_MAX_BYTES=65536
WORKER_SYNC_MAX_BYTES=8388608
WORKER_COMMAND_QUEUE_CAP=100
# Ephemeral live snapshots; durable message persistence is batched via HTTP sync.
WORKER_LIVE_MAX_BYTES=262144
WORKER_LIVE_TTL=15
